# Copy this file to .env and fill in your local values.
# .env is gitignored and must not be committed.

# Backend API base URL (no trailing slash). Defaults to http://localhost:8080 if unset.
VITE_API_URL=http://localhost:8080

# Set to "development" to enable dev-only features (e.g. Live Classes routes).
VITE_APP_ENV=development
